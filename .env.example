# ElevenLabs credentials — required for text-to-speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VOICE_ID=your_voice_id_here

# Server port (optional, defaults to 3000)
PORT=3000

# Anthropic — evidence gathering + Viva voice
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase — data layer (service_role key, server-side only)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Stripe checkout (Step 11 / FR-1.7) ──────────────────────────────────────
# One-time purchase via Checkout Sessions. Use test-mode keys for development.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Where Stripe redirects after checkout (no trailing slash).
CHECKOUT_BASE_URL=http://localhost:3000

# Pricing — amounts in the Stripe MINOR unit (paise / cents), NEVER hardcoded in
# code. Founding launch: ₹1,499 = 149900 paise, $39 = 3900 cents. To move to list
# pricing (₹2,999 / $79) later, change ONLY these values + the Stripe Price IDs.
PRICE_INR_AMOUNT=149900
PRICE_INR_ID=price_your_inr_price_id_here
PRICE_USD_AMOUNT=3900
PRICE_USD_ID=price_your_usd_price_id_here
